#!/usr/bin/env bash
# paw — project launcher
# usage: paw [command]
#   paw                    → 一键启动（自动检测 provider）
#   paw rebuild            → 强制重建 Paw.app 后启动
#   paw serve              → 只启动 Agent，不开 Paw
#   paw build              → 只构建 Go agent
#   paw test               → 跑测试
#   paw clean              → 清理产物
#   paw config longcat     → 切换到 LongCat（自动读取 ~/.zshrc 的 LONGCAT_API_KEY）
#   paw config deepseek    → 切换到 DeepSeek（需设 DEEPSEEK_API_KEY）
#   paw config anthropic   → 切换到 Anthropic（需设 ANTHROPIC_API_KEY）

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODEL_CFG="$SCRIPT_DIR/.ccagent/model.json"

load_longcat_api_key() {
    if [[ -n "${LONGCAT_API_KEY:-}" ]]; then
        return
    fi
    if command -v zsh >/dev/null 2>&1 && [[ -f "$HOME/.zshrc" ]]; then
        local value
        value="$(zsh -lic 'printf "%s" "${LONGCAT_API_KEY:-}"' 2>/dev/null || true)"
        if [[ -n "$value" ]]; then
            export LONGCAT_API_KEY="$value"
        fi
    fi
}

write_config() {
    mkdir -p "$SCRIPT_DIR/.ccagent"
    case "$1" in
      longcat)
        cat > "$MODEL_CFG" << JSON
{
  "provider": "custom",
  "api_base_url": "https://api.longcat.chat/openai",
  "api_path": "/chat/completions",
  "api_key_env_name": "LONGCAT_API_KEY",
  "model": "LongCat-2.0",
  "timeout_seconds": 120
}
JSON
        echo "✓ 已切换到 longcat（LongCat-2.0）"
        echo "  将自动读取 ~/.zshrc 中的 LONGCAT_API_KEY"
        ;;
      deepseek)
        cat > "$MODEL_CFG" << JSON
{
  "provider": "deepseek",
  "api_base_url": "https://api.deepseek.com",
  "api_path": "/chat/completions",
  "api_key_env_name": "DEEPSEEK_API_KEY",
  "model": "deepseek-chat",
  "timeout_seconds": 120
}
JSON
        echo "✓ 已切换到 deepseek（deepseek-chat）"
        echo "  记得设置: export DEEPSEEK_API_KEY=sk-..."
        ;;
      anthropic)
        cat > "$MODEL_CFG" << JSON
{
  "provider": "anthropic",
  "api_base_url": "https://api.anthropic.com",
  "api_path": "/v1/messages",
  "api_key_env_name": "ANTHROPIC_API_KEY",
  "model": "claude-opus-4-5-20251101",
  "timeout_seconds": 120
}
JSON
        echo "✓ 已切换到 anthropic（claude-opus-4-5）"
        echo "  记得设置: export ANTHROPIC_API_KEY=sk-ant-..."
        ;;
      *)
        echo "usage: paw config longcat|deepseek|anthropic"
        exit 1
        ;;
    esac
}

load_longcat_api_key

case "${1:-}" in
  rebuild)       exec "$SCRIPT_DIR/scripts/dev.sh" --rebuild ;;
  serve)         exec env AGENT_WS_PORT="${AGENT_WS_PORT:-8765}" LONGCAT_API_KEY="${LONGCAT_API_KEY:-}" go run "$SCRIPT_DIR/cmd/agent/..." ;;
  build)         exec go build "$SCRIPT_DIR/cmd/agent/..." ;;
  test)          exec go test "$SCRIPT_DIR/..." ;;
  clean)
    rm -f /tmp/codex-agent
    rm -rf /Users/united_pooh/PyProjects/Paw/build
    echo "cleaned"
    ;;
  config)        write_config "${2:-}" ;;
  ""|start)      exec "$SCRIPT_DIR/scripts/dev.sh" ;;
  *)
    echo "unknown command: $1"
    echo "usage: paw [rebuild|serve|build|test|clean|config longcat|config deepseek|config anthropic]"
    exit 1
    ;;
esac
